# ============================================================================
# 1. ENVIRONMENT & SERVER CONFIGURATION
# ============================================================================
NODE_ENV="development"
PORT="3001"
CORS_ALLOWED_ORIGIN="http://localhost:5173"

# ============================================================================
# 2. POSTGRESQL DATABASE (Drizzle ORM / Serverless Postgres or AWS RDS)
# ============================================================================
# Must include ?sslmode=require for serverless Postgres (Neon / Supabase / RDS)
DATABASE_URL="postgresql://db_user:db_password@ep-example-pooler.sa-east-1.aws.neon.tech:5432/listening_tutor?sslmode=require"

# ============================================================================
# 3. AWS CORE & S3 / CLOUDFRONT AUDIO CACHE
# ============================================================================
# In production Lambda, IAM execution roles handle credentials automatically.
# Only set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for local development.
AWS_REGION="sa-east-1"
# AWS_ACCESS_KEY_ID="your-local-dev-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-local-dev-secret-access-key"

# S3 Bucket & CloudFront CDN for caching synthesized TTS .mp3 files
S3_AUDIO_CACHE_BUCKET="a2-listening-tutor-audio-cache-prod"
S3_AUDIO_CACHE_PREFIX="audio-cache"
CLOUDFRONT_AUDIO_DOMAIN="https://d111111abcdef8.cloudfront.net"

# ============================================================================
# 4. AUTHENTICATION (Amazon Cognito + Google OAuth 2.0 SSO Only)
# ============================================================================
COGNITO_REGION="sa-east-1"
COGNITO_USER_POOL_ID="sa-east-1_XXXXXXXXX"
COGNITO_APP_CLIENT_ID="1234567890abcdefghijklmnop"
COGNITO_AUTH_DOMAIN="hormal.auth.sa-east-1.amazoncognito.com"

# Used by AWS SAM / CDK when provisioning the Cognito Google Identity Provider
GOOGLE_OAUTH_CLIENT_ID="123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-your_google_oauth_client_secret"

# ============================================================================
# 5. AI AGENTS (Google Gen AI SDK - Story, Correction & Doubt Agents)
# ============================================================================
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-3.8-flash"

# ============================================================================
# 6. PLUGGABLE FEMININE TTS VOICE ENGINES (Server-Side Synthesis)
# ============================================================================
# Engine 1: Amazon Polly (Uses Lambda IAM Role + AWS_REGION above)
POLLY_REGION="us-east-1"
POLLY_DEFAULT_ENGINE="generative"        # "generative" | "neural"
POLLY_SAMPLE_RATE="24000"
# Default Feminine Voice IDs per target language for Polly
POLLY_VOICE_DE="Vicki"                   # German (de-DE) - Generative/Neural
POLLY_VOICE_FR="Gabrielle"               # French (fr-FR) - Generative/Neural
POLLY_VOICE_ES="Lucia"                   # Spanish (es-ES) - Generative/Neural
POLLY_VOICE_IT="Beatrice"                # Italian (it-IT) - Generative/Neural
POLLY_VOICE_EN="Ruth"                    # English (en-US) - Generative/Neural
POLLY_VOICE_PT="Camila"                  # Portuguese (pt-BR) - Neural

# Engine 2: Google Cloud Text-to-Speech (Free Tier — 1M Chars/Month Free Forever)
# Uses ultra-natural Chirp 3: HD and Neural2 conversational feminine voices.
GOOGLE_TTS_API_KEY="AIzaSyYourGoogleTtsApiKeyHere"
GOOGLE_TTS_DEFAULT_VOICE_DE="de-DE-Chirp3-HD-Aoede"  # or de-DE-Neural2-F
GOOGLE_TTS_DEFAULT_VOICE_FR="fr-FR-Chirp3-HD-Aoede"  # or fr-FR-Neural2-A
GOOGLE_TTS_DEFAULT_VOICE_ES="es-ES-Chirp3-HD-Aoede"  # or es-ES-Neural2-A
GOOGLE_TTS_DEFAULT_VOICE_IT="it-IT-Chirp3-HD-Aoede"  # or it-IT-Neural2-A
GOOGLE_TTS_DEFAULT_VOICE_EN="en-US-Chirp3-HD-Aoede"  # or en-US-Neural2-F
GOOGLE_TTS_DEFAULT_VOICE_PT="pt-BR-Chirp3-HD-Aoede"  # or pt-BR-Neural2-A

# Engine 3: OpenAI Audio TTS (Optional - Low-Cost Pay-As-You-Go Warm Feminine Voice)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"       # "gpt-4o-mini-tts" | "tts-1"
OPENAI_TTS_DEFAULT_VOICE="nova"          # "nova" | "shimmer" | "coral"

# ============================================================================
# 7. FRONTEND VARIABLES (Vite / React 9:16 Mobile App)
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ============================================================================
VITE_API_BASE_URL="https://xxxxxxxxxx.execute-api.sa-east-1.amazonaws.com"
VITE_AUDIO_CDN_URL="https://d111111abcdef8.cloudfront.net"

# Cognito Google-SSO PKCE Redirect Config for Frontend
VITE_COGNITO_REGION="sa-east-1"
VITE_COGNITO_USER_POOL_ID="sa-east-1_XXXXXXXXX"
VITE_COGNITO_APP_CLIENT_ID="1234567890abcdefghijklmnop"
VITE_COGNITO_AUTH_DOMAIN="hormal.auth.sa-east-1.amazoncognito.com"
VITE_OAUTH_REDIRECT_SIGN_IN="http://localhost:5173/"
VITE_OAUTH_REDIRECT_SIGN_OUT="http://localhost:5173/"

# Default Fallback Profile Preferences (Overridden by User Profile in DB after Login)
VITE_DEFAULT_UI_LANGUAGE="en"
VITE_DEFAULT_TARGET_LANGUAGE="de-DE"
VITE_DEFAULT_CEFR_LEVEL="A2"
VITE_DEFAULT_VOICE_ENGINE="google_cloud_tts"