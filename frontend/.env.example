# Copy to .env.local and fill in with the CloudFormation stack outputs.
VITE_COGNITO_USER_POOL_ID=sa-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=hormal.auth.sa-east-1.amazoncognito.com
VITE_COGNITO_AUTH_DOMAIN=hormal.auth.sa-east-1.amazoncognito.com
# Leave empty in production (same-origin via CloudFront /api/*). For local dev point to the HttpApi URL:
VITE_API_BASE_URL=
